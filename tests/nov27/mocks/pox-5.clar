(define-trait signer-manager-trait ((validate-stake! (principal uint uint uint uint bool (optional (buff 500))) (response bool uint))))
(define-data-var info (optional {signer: principal, first-reward-cycle: uint, num-cycles: uint}) none)
(define-data-var last-update (optional {signer: principal, old: principal, cycles: uint, amount: uint, calldata: (optional (buff 500))}) none)
(define-public (set-info (i (optional {signer: principal, first-reward-cycle: uint, num-cycles: uint}))) (ok (var-set info i)))
(define-read-only (get-staker-info (who principal)) (var-get info))
(define-read-only (current-pox-reward-cycle) u10)
(define-public (stake-update (signer <signer-manager-trait>) (old <signer-manager-trait>) (cycles uint) (amount uint) (calldata (optional (buff 500))))
 (begin (asserts! true (err u999)) (var-set last-update (some {signer: (contract-of signer), old: (contract-of old), cycles: cycles, amount: amount, calldata: calldata})) (ok true)))
(define-read-only (get-last-update) (var-get last-update))
(define-public (stake (signer <signer-manager-trait>) (amount uint) (cycles uint) (height uint) (calldata (optional (buff 500)))) (if true (ok true) (err u999)))
(define-public (unstake (signer <signer-manager-trait>)) (if true (ok true) (err u999)))
